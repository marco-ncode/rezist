{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rezist:unit_abilities.schema.json",
  "title": "Unit Abilities",
  "type": "object",
  "required": ["abilities"],
  "additionalProperties": false,
  "properties": {
    "abilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "unit_class", "unlock_cost", "cooldown_seconds", "effect"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "unit_class": { "type": "string", "minLength": 1 },
          "unlock_cost": { "type": "integer", "minimum": 0 },
          "cooldown_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "effect": { "enum": ["plunge_damage_knockback", "focused_ranged_burst", "line_impale_charge"] }
        }
      }
    }
  }
}
