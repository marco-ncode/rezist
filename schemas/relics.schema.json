{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rezist:relics.schema.json",
  "title": "Relics (Field Gear)",
  "type": "object",
  "required": ["relics"],
  "additionalProperties": false,
  "properties": {
    "relics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "cost", "effect"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "cost": { "type": "integer", "minimum": 0 },
          "effect": {
            "enum": [
              "area_damage",
              "revive_commander",
              "redeploy",
              "trap_on_contact",
              "bonus_gold_per_mission",
              "squad_max_size_add",
              "instant_reinforcements"
            ]
          }
        }
      }
    }
  }
}
