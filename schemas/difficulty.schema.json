{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rezist:difficulty.schema.json",
  "title": "Difficulty Tiers",
  "type": "object",
  "required": ["tiers"],
  "additionalProperties": false,
  "properties": {
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "enemy_hp_mult", "enemy_damage_mult", "spawn_count_mult", "gold_mult", "slow_mo_time_scale"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "enemy_hp_mult": { "type": "number", "exclusiveMinimum": 0 },
          "enemy_damage_mult": { "type": "number", "exclusiveMinimum": 0 },
          "spawn_count_mult": { "type": "number", "exclusiveMinimum": 0 },
          "gold_mult": { "type": "number", "exclusiveMinimum": 0 },
          "slow_mo_time_scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
