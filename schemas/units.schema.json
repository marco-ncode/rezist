{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rezist:units.schema.json",
  "title": "Units",
  "type": "object",
  "required": ["classes", "squad_base_max_size"],
  "additionalProperties": false,
  "properties": {
    "squad_base_max_size": { "type": "integer", "minimum": 1 },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "levels", "blocks_ranged_frontal", "armor_type", "ability_id", "promotes_to"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "blocks_ranged_frontal": { "type": "boolean" },
          "armor_type": { "enum": ["none", "shield", "reach"] },
          "ability_id": { "type": ["string", "null"] },
          "promotes_to": { "type": "array", "items": { "type": "string" } },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["level", "hp", "damage", "reach", "attack_type", "speed", "cost"],
              "additionalProperties": false,
              "properties": {
                "level": { "type": "integer", "minimum": 1, "maximum": 3 },
                "hp": { "type": "integer", "minimum": 1 },
                "damage": { "type": "integer", "minimum": 0 },
                "reach": { "type": "integer", "minimum": 1 },
                "attack_type": { "enum": ["melee", "ranged"] },
                "speed": { "type": "number", "exclusiveMinimum": 0 },
                "cost": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
