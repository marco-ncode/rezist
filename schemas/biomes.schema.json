{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rezist:biomes.schema.json",
  "title": "Biomes",
  "type": "object",
  "required": ["biomes"],
  "additionalProperties": false,
  "properties": {
    "biomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "tile_palette", "ambient_mood"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "tile_palette": { "type": "string", "minLength": 1 },
          "ambient_mood": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
