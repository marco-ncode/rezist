{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rezist:enemies.schema.json",
  "title": "Enemies",
  "type": "object",
  "required": ["enemies"],
  "additionalProperties": false,
  "properties": {
    "enemies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "hp", "damage", "attack_type", "range", "speed", "behavior", "blocks_ranged_frontal", "weak_to", "can_cross_gaps", "knockback_immune"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "hp": { "type": "integer", "minimum": 1 },
          "damage": { "type": "integer", "minimum": 0 },
          "attack_type": { "enum": ["melee", "ranged"] },
          "range": { "type": "integer", "minimum": 1 },
          "speed": { "type": "number", "exclusiveMinimum": 0 },
          "behavior": { "enum": ["swarm", "tank_advance", "ranged_kite", "swarm_ranged", "leap_flank", "siege_boss"] },
          "blocks_ranged_frontal": { "type": "boolean" },
          "weak_to": { "type": ["string", "null"], "enum": ["reach", null] },
          "can_cross_gaps": { "type": "boolean" },
          "knockback_immune": { "type": "boolean" },
          "is_boss": { "type": "boolean" },
          "melee_followup_damage": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
