; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes to [section] group in the engine's ProjectSettings.
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="REZIST"
config/description="Real-time tactics roguelite — contemporary city under zombie siege. Spiritual mechanical clone of Bad North."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DataLoader="*res://autoload/DataLoader.gd"
AudioManager="*res://autoload/AudioManager.gd"
GameState="*res://autoload/GameState.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
